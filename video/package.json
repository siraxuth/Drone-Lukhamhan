    "qrcode": "^1.5.4",
    "react": "19",
    "react-dom": "19",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "bun-types": "^1.4.4",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2"
  }
