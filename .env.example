# ===== คัดลอกเป็น .env.local ตอนพัฒนา · บน Vercel ตั้งใน Project Settings → Environment Variables =====

# โดเมนจริงของเว็บ (ใช้ทำ canonical, sitemap, Open Graph) · ไม่ตั้งจะใช้ https://drone.dekgp.com
NEXT_PUBLIC_SITE_URL="https://drone.dekgp.com"

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth: BETTER_AUTH_URL = โดเมนที่ผู้ใช้เปิด (dev = http://localhost:3000)
BETTER_AUTH_SECRET="สุ่มอย่างน้อย 32 ตัวอักษร เช่น openssl rand -base64 32"
BETTER_AUTH_URL="https://drone.dekgp.com"

# อีเมลที่สมัครแล้วเป็น ADMIN อัตโนมัติ (คั่นด้วย ,)
ADMIN_EMAILS="you@example.com"

# Cloudflare R2 (S3 API) — เก็บรูปทั้งหมดใต้ path drone_lukhamhan/
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://<your-bucket>.r2.dev"

# (ไม่บังคับ) รหัสยืนยันความเป็นเจ้าของเว็บกับ Google Search Console / Bing Webmaster
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
